<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrollRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/gutter"
        android:paddingEnd="@dimen/gutter"
        android:paddingTop="22dp"
        android:paddingBottom="30dp">

        <!-- ═══════════ ENCABEZADO ═══════════ -->
        <TextView style="@style/Text.Mark" android:text="@string/app_mark" />
        <TextView style="@style/Text.H1" android:text="@string/main_title" />
        <TextView style="@style/Text.Body" android:text="@string/main_subtitle" />

        <View style="@style/Rule" />

        <!-- ═══════════ CONSOLA ═══════════ -->
        <LinearLayout style="@style/Console.Panel">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Text.ConsoleLabel"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/console_label" />

                <ProgressBar
                    android:id="@+id/pbBusy"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:indeterminateTint="@color/console_text"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvConsole"
                style="@style/Text.Console"
                android:text="@string/console_idle" />
        </LinearLayout>

        <!-- ═══════════ ACCIONES SOBRE EL RESULTADO ═══════════ -->
        <LinearLayout
            android:id="@+id/rowOutputActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <Button
                android:id="@+id/btnShareOut"
                style="@style/Button.Solid"
                android:text="@string/btn_share_file" />

            <Button
                android:id="@+id/btnCopyOut"
                style="@style/Button.Small"
                android:text="@string/btn_copy" />

            <Button
                android:id="@+id/btnSaveOut"
                style="@style/Button.Small"
                android:text="@string/btn_save" />
        </LinearLayout>

        <TextView style="@style/Text.SectionTitle" android:text="@string/section_modules" />

        <!-- ═══════════ 01 · EXIF ═══════════ -->
        <LinearLayout style="@style/Module.Card">
            <TextView style="@style/Text.ModuleTitle" android:text="@string/mod1_title" />
            <TextView style="@style/Text.ModuleBody" android:text="@string/mod1_body" />
            <Button
                android:id="@+id/btnExif"
                style="@style/Button.Outline"
                android:text="@string/mod1_btn" />
        </LinearLayout>

        <!-- ═══════════ 02 · ENLACES ═══════════ -->
        <LinearLayout style="@style/Module.Card">
            <TextView style="@style/Text.ModuleTitle" android:text="@string/mod2_title" />
            <TextView style="@style/Text.ModuleBody" android:text="@string/mod2_body" />

            <EditText
                android:id="@+id/etLink"
                style="@style/Input.Mono"
                android:hint="@string/mod2_hint" />

            <Button
                android:id="@+id/btnCleanLink"
                style="@style/Button.Outline"
                android:text="@string/mod2_btn" />
        </LinearLayout>

        <!-- ═══════════ 03 · PORTAPAPELES ═══════════ -->
        <LinearLayout style="@style/Module.Card">
            <TextView style="@style/Text.ModuleTitle" android:text="@string/mod3_title" />
            <TextView style="@style/Text.ModuleBody" android:text="@string/mod3_body" />

            <TextView
                android:id="@+id/tvClipState"
                style="@style/Text.AuditDetail"
                android:layout_marginBottom="12dp"
                android:text="@string/mod3_state_none" />

            <Button
                android:id="@+id/btnWipe"
                style="@style/Button.Accent"
                android:text="@string/mod3_btn" />

            <TextView
                style="@style/Text.AuditDetail"
                android:layout_marginTop="10dp"
                android:text="@string/mod3_privacy" />
        </LinearLayout>

        <!-- ═══════════ 04 · ATAJOS ═══════════ -->
        <LinearLayout style="@style/Module.Card">
            <TextView style="@style/Text.ModuleTitle" android:text="@string/mod4_title" />
            <TextView style="@style/Text.ModuleBody" android:text="@string/mod4_body" />
            <Button
                android:id="@+id/btnShortcuts"
                style="@style/Button.Outline"
                android:text="@string/mod4_btn" />
        </LinearLayout>

        <!-- ═══════════ 05 · AUDITORÍA ═══════════ -->
        <LinearLayout style="@style/Module.Card">
            <TextView style="@style/Text.ModuleTitle" android:text="@string/mod5_title" />
            <TextView style="@style/Text.ModuleBody" android:text="@string/mod5_body" />
            <Button
                android:id="@+id/btnAudit"
                style="@style/Button.Outline"
                android:text="@string/mod5_btn" />
        </LinearLayout>

        <!-- Resultado del diagnóstico -->
        <LinearLayout
            android:id="@+id/auditContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView style="@style/Text.Footer" android:text="@string/footer_note" />
    </LinearLayout>
</ScrollView>
