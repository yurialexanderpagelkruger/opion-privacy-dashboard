    <string name="main_title">Privacy Dashboard</string>
    <string name="main_subtitle">Five local tools. Nothing ever leaves your device.</string>
    <string name="console_label">OUTPUT</string>
    <string name="console_idle">› ready. waiting for input…</string>
    <string name="section_modules">MODULES</string>

    <string name="btn_share_file">SHARE CLEAN COPY</string>
    <string name="btn_share_text">SHARE CLEAN TEXT</string>
    <string name="btn_copy">COPY RESULT</string>
    <string name="btn_save">SAVE TO GALLERY</string>
    <string name="chooser_title">Send with…</string>
    <string name="nothing_to_share">Nothing to share yet.</string>
    <string name="copied_ok">Result copied to the clipboard.</string>

    <string name="mod1_title">01 · EXIF SANITIZER</string>
    <string name="mod1_body">Strips GPS, date, camera model and every other metadata tag from a photo. No re-encoding — image quality stays untouched.</string>
    <string name="mod1_btn">PICK IMAGE AND CLEAN</string>

    <string name="mod2_title">02 · LINK CLEANER</string>
    <string name="mod2_body">Removes spy parameters (utm_*, fbclid, igsh, si…) and unwraps redirect links from Instagram, TikTok, YouTube, MercadoLibre.</string>
    <string name="mod2_hint">https://…  ·  www.…  ·  paste or share a link</string>
    <string name="mod2_btn">CLEAN LINKS</string>
    <string name="mod2_nochange">No tracking parameters found.</string>

    <string name="mod3_title">03 · CLIPBOARD WIPER</string>
    <string name="mod3_body">Overwrites and clears the system clipboard. No password or token is left lingering in memory.</string>
    <string name="mod3_state_none">status: empty or no access</string>
    <string name="mod3_state_some">status: %1$d characters on the clipboard</string>
    <string name="mod3_btn">WIPE CLIPBOARD</string>
    <string name="mod3_done">Clipboard wiped.</string>
    <string name="mod3_fail">Couldn\'t wipe the clipboard.</string>
    <string name="mod3_privacy">By design, the app never shows the content — only its size.</string>

    <string name="mod4_title">04 · CRITICAL SETTINGS SHORTCUTS</string>
    <string name="mod4_body">Direct shortcuts into the system panels that matter: permissions, Private DNS, battery and more. Nothing beyond what you already have.</string>
    <string name="mod4_btn">OPEN SHORTCUTS</string>

    <string name="mod5_title">05 · SECURITY AUDIT</string>
    <string name="mod5_body">Checks screen lock, USB debugging, root, encryption, Private DNS, accessibility and notification listeners.</string>
    <string name="mod5_btn">RUN DIAGNOSTIC</string>

    <string name="shortcuts_title">SYSTEM SHORTCUTS</string>
    <string name="shortcuts_subtitle">Android owns these panels. We just take you to the exact spot.</string>
    <string name="shortcuts_footer">>> If a panel doesn\'t exist on your manufacturer\'s build, the app automatically tries the fallback route.</string>
    <string name="shortcuts_open_failed">Couldn\'t open this panel on this device.</string>

    <string name="footer_note">zero permissions · no network · zero telemetry\n\nDeveloped by Yuri Alexander Pagel Krüger</string>

