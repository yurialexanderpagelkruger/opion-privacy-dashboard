    <string name="audit_lock_title">Screen lock</string>
    <string name="audit_lock_ok">Active. The device asks for credentials on wake.</string>
    <string name="audit_lock_bad">NO screen lock. Anyone who picks up the phone gets full access. Set a PIN or password in Settings → Security.</string>

    <string name="audit_bio_title">Biometrics</string>
    <string name="audit_bio_ok">Hardware supports fingerprint or face unlock.</string>
    <string name="audit_bio_none">No biometric hardware detected (not a problem).</string>

    <string name="audit_usb_title">USB debugging</string>
    <string name="audit_usb_bad">ON. With physical access and a PC, data can be read and commands executed. Turn it off when not in use.</string>
    <string name="audit_usb_ok">Off.</string>

    <string name="audit_dev_title">Developer options</string>
    <string name="audit_dev_warn">Enabled. Extra attack surface — review what you left on.</string>
    <string name="audit_dev_ok">Disabled.</string>

    <string name="audit_wadb_title">Wireless ADB</string>
    <string name="audit_wadb_na">Not applicable on this Android version.</string>
    <string name="audit_wadb_bad">ON. Debugging over the network, no cable needed. Very risky on public networks.</string>
    <string name="audit_wadb_ok">Off.</string>

    <string name="audit_root_title">Root</string>
    <string name="audit_root_binaries">Root binaries detected: %1$s</string>
    <string name="audit_root_more"> (+%1$d more)</string>
    <string name="audit_root_packages">Root manager apps installed: %1$s</string>
    <string name="audit_root_testkeys">Development build signature (test-keys).</string>
    <string name="audit_root_clean">No traces of root found.</string>

    <string name="audit_enc_title">Storage encryption</string>
    <string name="audit_enc_ok">Active. Data at rest is encrypted.</string>
    <string name="audit_enc_bad">Supported but INACTIVE.</string>
    <string name="audit_enc_unknown">Could not determine the status on this device.</string>

    <string name="audit_dns_title">Private DNS</string>
    <string name="audit_dns_hostname">Active with a custom server: %1$s</string>
    <string name="audit_dns_unspecified">unspecified</string>
    <string name="audit_dns_opportunistic">Opportunistic mode. It works, but does not guarantee the DNS server you picked. Set a hostname (AdGuard / NextDNS / Cloudflare) to block tracking.</string>
    <string name="audit_dns_off">OFF. Your carrier or the network sees every domain you visit. This is the highest-impact setting you can change.</string>
    <string name="audit_dns_unknown">Could not read the status (requires Android 9 or newer).</string>

    <string name="audit_acc_title">Accessibility</string>
    <string name="audit_acc_warn">%1$d service(s) active. An accessibility service can READ the whole screen and simulate taps: make sure you know all of them.</string>
    <string name="audit_acc_ok">No accessibility services active.</string>

    <string name="audit_notif_title">Notification listeners</string>
    <string name="audit_notif_warn">%1$d app(s) can read ALL your notifications (2FA codes, messages). Check Settings → Notifications → Notification access.</string>
    <string name="audit_notif_ok">No app can read your notifications.</string>

    <string name="audit_admin_title">Device admins</string>
    <string name="audit_admin_warn">%1$d app(s) hold administrative permissions. They can wipe data or force locks. Check Settings → Security → Device admin apps.</string>
    <string name="audit_admin_ok">No app with admin permissions.</string>

    <string name="audit_timeout_title">Screen-off timeout</string>
    <string name="audit_timeout_unknown">Could not read it. Set a timeout of up to 1 minute.</string>
    <string name="audit_timeout_ok">%1$ds. Good.</string>
    <string name="audit_timeout_warn">%1$ds. Leaving the screen on for a long time makes physical access easier.</string>

    <string name="audit_selinux_title">SELinux</string>
    <string name="audit_selinux_ok">Enforcing mode. This is the secure state.</string>
    <string name="audit_selinux_bad">PERMISSIVE mode. This is insecure: the system does not block processes even when they violate the rules.</string>
    <string name="audit_selinux_unknown">Could not determine (this is normal: the getenforce binary is not always accessible).</string>

