<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Text" />
    <style name="Module" />
    <style name="Console" />
    <style name="Input" />

    <style name="Text.Mark">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.28</item>
        <item name="android:textColor">@color/graphite</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Text.H1">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">21sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:layout_marginTop">6dp</item>
    </style>

    <style name="Text.Body">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/graphite</item>
        <item name="android:lineSpacingExtra">3dp</item>
        <item name="android:layout_marginTop">6dp</item>
    </style>

    <style name="Text.SectionTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.22</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>

    <style name="Text.ModuleTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.10</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="Text.ModuleBody">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/graphite</item>
        <item name="android:lineSpacingExtra">2dp</item>
        <item name="android:layout_marginTop">5dp</item>
        <item name="android:layout_marginBottom">12dp</item>
    </style>

    <style name="Text.ConsoleLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.24</item>
        <item name="android:textColor">@color/console_dim</item>
    </style>

    <style name="Text.Console">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/console_text</item>
        <item name="android:lineSpacingExtra">4dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:textIsSelectable">true</item>
    </style>

    <style name="Text.Marker">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minWidth">54dp</item>
    </style>

    <style name="Text.AuditTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="Text.AuditDetail">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/graphite</item>
        <item name="android:lineSpacingExtra">2dp</item>
        <item name="android:layout_marginTop">2dp</item>
    </style>

    <style name="Text.Footer">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">@color/graphite</item>
        <item name="android:lineSpacingExtra">3dp</item>
        <item name="android:layout_marginTop">26dp</item>
    </style>

    <style name="Text.SplashMark">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">19sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.26</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="Text.SplashCredit">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textColor">@color/graphite</item>
    </style>

    <style name="Text.SplashFooter">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">10sp</item>
        <item name="android:letterSpacing">0.16</item>
        <item name="android:textColor">@color/graphite</item>
        <item name="android:layout_marginBottom">28dp</item>
    </style>


    <style name="Rule">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/line</item>
        <item name="android:layout_marginTop">18dp</item>
        <item name="android:layout_marginBottom">18dp</item>
    </style>

    <style name="Rule.Mini">
        <item name="android:layout_width">64dp</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/ink</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:layout_marginBottom">16dp</item>
    </style>

    <style name="Module.Card">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">14dp</item>
        <item name="android:layout_marginBottom">12dp</item>
    </style>

    <style name="Console.Panel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/bg_console</item>
        <item name="android:padding">14dp</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:layout_marginBottom">12dp</item>
    </style>

    <style name="Button.Base" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">50dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">50dp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.13</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>

    <style name="Button.Outline" parent="Button.Base">
        <item name="android:background">@drawable/bg_btn_outline</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="Button.Solid" parent="Button.Base">
        <item name="android:background">@drawable/bg_btn_solid</item>
        <item name="android:textColor">@color/paper</item>
    </style>

    <style name="Button.Accent" parent="Button.Base">
        <item name="android:background">@drawable/bg_btn_accent</item>
        <item name="android:textColor">@color/paper</item>
        <item name="android:textSize">13sp</item>
        <item name="android:layout_height">56dp</item>
    </style>

    <style name="Button.Small" parent="Button.Base">
        <item name="android:layout_height">44dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:background">@drawable/bg_btn_outline</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="Button.Shortcut" parent="Button.Base">
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_marginBottom">7dp</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:background">@drawable/bg_btn_outline</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="Input.Mono">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textColorHint">@color/graphite</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:gravity">top|start</item>
        <item name="android:maxLines">6</item>
        <item name="android:inputType">textUri|textMultiLine|textNoSuggestions</item>
        <item name="android:importantForAutofill">no</item>
        <item name="android:layout_marginBottom">10dp</item>
    </style>
</resources>
